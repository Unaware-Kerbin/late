{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Late",
  "version": "0.1.4",
  "identifier": "dev.late.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w late-desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -w late-desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Late — Local AI Terminal Emulator",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
