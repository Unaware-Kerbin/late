# Copy to docker/.env after running ./detect-gpus.sh
# ZE_AFFINITY_MASK=1,2  (or 0,2 when the iGPU is Level Zero index 1)

VLLM_IMAGE=intel/llm-scaler-vllm:0.21.0-b3
# Fallback: intel/llm-scaler-vllm:0.14.0-b8.2.1

ZE_AFFINITY_MASK=1,2
TP=1
MODEL_PATH=Qwen/Qwen3-8B
SERVED_NAME=local
DTYPE=float16
MAX_MODEL_LEN=8192
LATE_MODEL_DIR=./models
# HF_HOME defaults to ~/.cache/huggingface (mounted into the container)
