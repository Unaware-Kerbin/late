# Optional Intel Arc / XPU compose only. NVIDIA and AMD: do not copy this file.
# Use Ollama, llama.cpp, or a CUDA/ROCm vLLM install instead, then point Late
# at that vLLM URL.
#
# Discrete Intel GPUs:
#   ./detect-gpus.sh .env
# Do not copy ZE_AFFINITY_MASK or GIDs from another machine.

VLLM_IMAGE=intel/llm-scaler-vllm:0.21.0-b3
# Fallback: intel/llm-scaler-vllm:0.14.0-b8.2.1

ZE_AFFINITY_MASK=1,2
TP=1
MODEL_PATH=Qwen/Qwen3-8B
SERVED_NAME=local
DTYPE=float16
MAX_MODEL_LEN=8192
LATE_MODEL_DIR=./models
# HF_HOME defaults to ~/.cache/huggingface (mounted into the container)
